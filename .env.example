# Define quais origens podem abrir esta aplicacao dentro de um iframe.
# Informe a origem exata: protocolo + dominio + porta (quando houver), sem caminho e sem barra final.
# Local: GI_FRAME_ANCESTORS=http://localhost:8000
# Producao: GI_FRAME_ANCESTORS=https://gi.dominio.com.br
# Para autorizar mais de uma origem, separe-as por espaco.
# Exemplo: GI_FRAME_ANCESTORS=http://localhost:8000 https://gi.dominio.com.br
# Nao use GI_FRAME_ANCESTORS=* porque permitiria que qualquer site incorporasse a aplicacao.
GI_FRAME_ANCESTORS=http://localhost:8000
# Use true para permitir acesso direto fora do iframe; mantenha false para exigir uma sessao autenticada pelo GI.
GI_ALLOW_OUTSIDE_IFRAME=true






